# Copy this file to .env and fill in the required credentials before running the script.

# Option 1: Paste the entire Google service account JSON (escape newlines).
#GOOGLE_SERVICE_ACCOUNT_INFO='{"type": "service_account", "project_id": "your-project", ... }'

# Option 2: Provide the path to the Google service account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/credentials.json

# (Optional) Override the default Google Sheet and worksheet.
#GOOGLE_SHEET_ID=1Q0RmoCgONCwld0cpcSFWf-bWWEMdCnBaiPRuEdv38CA
#GOOGLE_WORKSHEET_TITLE=Feuille 1

# (Optional) ROI / profit filters. Rows that do not meet these thresholds are skipped.
#MIN_ROI_PERCENT=30
#MIN_PROFIT_EUR=3.5

# (Optional) Enable ASIN lookups via Rainforest API.
#RAINFOREST_API_KEY=your_rainforest_api_key
#ENABLE_AMAZON_LOOKUP=true

# Logging level for the script (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
